{
  "name": "jobline-gcode",
  "displayName": "JobLine G-Code Intelligence",
  "description": "Deep G-code and robot-program intelligence for CNC machinists and automation engineers — syntax highlighting, hover tooltips, canned cycle & probing detection, Macro B evaluation, Fanuc/Haas/Siemens/Mazak/Okuma CNC dialects, Fanuc Robot TP, and ABB RAPID.",
  "version": "0.3.3",
  "publisher": "WeCr8-Solutions",
  "license": "MIT",
  "author": {
    "name": "WeCr8 Solutions, LLC",
    "url": "https://github.com/WeCr8-Solutions"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WeCr8-Solutions/jobline.ai-g-code.git"
  },
  "homepage": "https://github.com/WeCr8-Solutions/jobline.ai-g-code#readme",
  "bugs": {
    "url": "https://github.com/WeCr8-Solutions/jobline.ai-g-code/issues"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#161B33",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "gcode",
    "g-code",
    "cnc",
    "dnc",
    "fanuc",
    "fanuc robot",
    "haas",
    "siemens",
    "mazak",
    "okuma",
    "abb",
    "rapid",
    "robot",
    "machining",
    "nc",
    "canned cycle",
    "macro b",
    "mill",
    "lathe"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gcode",
        "aliases": [
          "G-Code",
          "gcode",
          "NC"
        ],
        "extensions": [
          ".nc",
          ".gcode",
          ".ngc",
          ".tap",
          ".cnc",
          ".g",
          ".min",
          ".prg",
          ".mpf",
          ".spf",
          ".eia",
          ".iso",
          ".ncc",
          ".ncp",
          ".ncf",
          ".nc1",
          ".5ax",
          ".fgc",
          ".dnc",
          ".apt",
          ".cls",
          ".cyc",
          ".tab",
          ".ptp",
          ".src",
          ".sub",
          ".lib"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "fanuc-tp",
        "aliases": [
          "Fanuc TP",
          "Fanuc Robot",
          "LS Program"
        ],
        "extensions": [
          ".ls",
          ".tp"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "abb-rapid",
        "aliases": [
          "ABB RAPID",
          "RAPID"
        ],
        "extensions": [
          ".mod",
          ".pgf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gcode",
        "scopeName": "source.gcode",
        "path": "./syntaxes/gcode.tmLanguage.json"
      },
      {
        "language": "fanuc-tp",
        "scopeName": "source.gcode",
        "path": "./syntaxes/gcode.tmLanguage.json"
      },
      {
        "language": "abb-rapid",
        "scopeName": "source.gcode",
        "path": "./syntaxes/gcode.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "JobLine G-Code",
      "properties": {
        "jobline.controlType": {
          "type": "string",
          "default": "fanuc",
          "enum": [
            "fanuc",
            "haas",
            "siemens",
            "mazak",
            "okuma",
            "fanuc-robot",
            "abb"
          ],
          "enumDescriptions": [
            "Fanuc 0i / 30i / 31i CNC series",
            "Haas NGC controls",
            "Siemens Sinumerik 840D / 828D",
            "Mazak Smooth / Matrix controls",
            "Okuma OSP-P controls",
            "Fanuc Robot — TP / LS teach-pendant programs",
            "ABB Robot — RAPID .mod programs"
          ],
          "description": "CNC or robot control dialect for dialect-specific parsing and validation."
        },
        "jobline.machineType": {
          "type": "string",
          "default": "mill",
          "enum": [
            "mill",
            "lathe",
            "mill-turn",
            "grinder"
          ],
          "enumDescriptions": [
            "Mill profile: drilling/spotface cycles like G81/G82/G83 plus rigid tapping.",
            "Lathe profile: turning-oriented cycles such as G74/G76 and drilling cycles.",
            "Mill-turn profile: combined mill + lathe cycle families.",
            "Grinder profile: simplified drilling/position cycles (commonly G81/G82)."
          ],
          "description": "Machine type profile used to tailor cycle lists and axis assumptions in JobLine views."
        },
        "jobline.units": {
          "type": "string",
          "default": "inch",
          "enum": [
            "inch",
            "metric"
          ],
          "description": "Default unit system (can be overridden by G20/G21 in program)."
        },
        "jobline.validation.enableSafetyChecks": {
          "type": "boolean",
          "default": true,
          "description": "Enable crash-prevention safety rules (safe Z before tool change, spindle stop, etc.)."
        },
        "jobline.validation.enableArcValidation": {
          "type": "boolean",
          "default": true,
          "description": "Validate G02/G03 arc endpoint geometry and plane correctness."
        },
        "jobline.validation.arcTolerance": {
          "type": "number",
          "default": 0.001,
          "description": "Arc endpoint tolerance in current units (default 0.001 inch)."
        },
        "jobline.formatter.wordSpacing": {
          "type": "boolean",
          "default": true,
          "description": "Add spaces between G-code words (G01X1.5 → G01 X1.5)."
        },
        "jobline.formatter.decimalPlaces": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Fixed decimal places for coordinates (null = don't change)."
        },
        "jobline.formatter.uppercaseGM": {
          "type": "boolean",
          "default": true,
          "description": "Uppercase G and M codes."
        },
        "jobline.detectedMachineType": {
          "type": "string",
          "default": "",
          "description": "Auto-detected or manually selected machine type."
        },
        "jobline.additionalExtensions": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra file extensions to treat as G-code (e.g. [\".cpp\", \".sub\", \".001\"]). Useful for shop-specific file naming conventions not covered by the built-in list."
        }
      }
    },
