        {
          "command": "jobline.presets.duplicate",
          "when": "view == jobline.machineSetupTree && viewItem =~ /^presetItem/",
          "group": "2_edit@2"
        },
        {
          "command": "jobline.presets.export",
          "when": "view == jobline.machineSetupTree && viewItem =~ /^presetItem/",
          "group": "2_edit@3"
        },
        {
          "command": "jobline.presets.delete",
          "when": "view == jobline.machineSetupTree && viewItem == presetItem.file",
          "group": "3_delete"
        },
        {
          "command": "jobline.presets.switch",
          "when": "view == jobline.machineSetupTree && viewItem =~ /^(activePreset|noActivePreset)$/",
          "group": "inline"
        },
        {
          "command": "jobline.presets.edit",
          "when": "view == jobline.machineSetupTree && viewItem == activePreset",
          "group": "1_use"
        }
      ],
      "commandPalette": [
        {
          "command": "jobline.placement.run",
          "when": "false"
