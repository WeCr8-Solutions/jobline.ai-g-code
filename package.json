          "group": "1_library"
        }
      ],
      "view/item/context": [
        {
          "command": "jobline.tools.goToTool",
          "when": "view == jobline.toolsTree && viewItem == toolItem",
          "group": "inline@1"
        },
        {
          "command": "jobline.tools.removeToolChange",
          "when": "view == jobline.toolsTree && viewItem == toolItem",
          "group": "inline@2"
        },
        {
          "command": "jobline.presets.apply",
          "when": "view == jobline.machineSetupTree && viewItem =~ /^presetItem/",
          "group": "inline@1"
        },
        {
          "command": "jobline.presets.setDefault",
          "when": "view == jobline.machineSetupTree && viewItem =~ /^presetItem/",
          "group": "inline@2"
        },
        {
          "command": "jobline.presets.apply",
          "when": "view == jobline.machineSetupTree && viewItem =~ /^presetItem/",
          "group": "1_use@1"
        },
        {
          "command": "jobline.presets.setDefault",
          "when": "view == jobline.machineSetupTree && viewItem =~ /^presetItem/",
          "group": "1_use@2"
