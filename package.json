          "group": "navigation@0"
        },
        {
          "command": "jobline.gcode.play",
          "when": "resourceLangId == gcode",
          "group": "navigation@1"
        },
        {
          "command": "jobline.gcode.pause",
          "when": "resourceLangId == gcode",
          "group": "navigation@2"
        },
        {
          "command": "jobline.gcode.stepBack",
          "when": "resourceLangId == gcode",
          "group": "navigation@3"
        },
        {
          "command": "jobline.gcode.stepForward",
          "when": "resourceLangId == gcode",
          "group": "navigation@4"
        },
