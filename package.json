{
  "name": "jobline-gcode",
  "displayName": "JobLine G-Code Intelligence",
  "description": "Check, explain and preview CNC G-code before it runs: hover explanations, live diagnostics, formatter, 3D toolpath visualizer, machine presets, probing, Macro B and tap drill checks for Fanuc, Haas, Siemens, Mazak and Okuma, plus Fanuc Robot TP and ABB RAPID.",
  "version": "0.3.14",
  "publisher": "WeCr8-Solutions",
  "license": "MIT",
  "author": {
    "name": "WeCr8 Solutions, LLC",
    "url": "https://github.com/WeCr8-Solutions"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WeCr8-Solutions/jobline.ai-g-code.git"
  },
  "homepage": "https://jobline.ai/tools?utm_source=vscode&utm_medium=marketplace&utm_campaign=jobline-gcode",
  "bugs": {
    "url": "https://github.com/WeCr8-Solutions/jobline.ai-g-code/issues"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0A1023",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Visualization"
  ],
  "keywords": [
    "CNC",
    "G-code",
    "gcode",
    "Fanuc",
    "Haas",
    "Siemens",
    "Sinumerik",
    "Mazak",
    "Okuma",
    "Macro B",
    "robot",
    "ABB RAPID",
    "Fanuc TP",
    "machinist",
    "CNC programming",
    "toolpath",
    "NC",
    "machining",
    "canned cycle",
    "probing",
    "mill",
    "lathe",
    "tap drill",
    "Fusion 360"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gcode",
        "aliases": [
          "G-Code",
          "gcode",
          "NC"
        ],
        "extensions": [
          ".nc",
          ".gcode",
          ".ngc",
          ".tap",
          ".cnc",
          ".g",
          ".min",
          ".prg",
          ".mpf",
          ".spf",
          ".eia",
          ".iso",
          ".ncc",
          ".ncp",
          ".ncf",
          ".nc1",
          ".5ax",
          ".fgc",
          ".dnc",
          ".apt",
          ".cls",
          ".cyc",
          ".tab",
          ".ptp",
          ".src",
          ".sub",
          ".lib",
          ".cmx",
          ".NC",
          ".GCODE",
          ".NGC",
          ".TAP",
          ".CNC",
          ".G",
          ".MIN",
          ".PRG",
          ".MPF",
          ".SPF",
          ".EIA",
          ".ISO",
          ".NCC",
          ".NCP",
          ".NCF",
          ".NC1",
          ".5AX",
          ".FGC",
          ".DNC",
          ".APT",
          ".CLS",
          ".CYC",
          ".TAB",
          ".PTP",
          ".SRC",
          ".SUB",
          ".LIB",
          ".CMX"
        ],
        "configuration": "./language-configuration.json",
        "firstLine": "^\\s*(%|[Oo]\\d{3,5}\\b|:\\d{3,5}\\b|[Nn]\\d+\\s*[GgMmTt]\\d|[Gg]\\d{1,3}(\\.\\d)?\\b|\\d+\\s+BEGIN\\s+PGM\\s)"
      },
      {
        "id": "fanuc-tp",
        "aliases": [
          "Fanuc TP",
          "Fanuc Robot",
          "LS Program"
        ],
        "extensions": [
          ".ls",
          ".tp"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "abb-rapid",
        "aliases": [
          "ABB RAPID",
          "RAPID"
        ],
        "extensions": [
          ".mod",
          ".pgf"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "json",
        "extensions": [
          ".jblmachine"
        ]
      }
    ],
    "grammars": [
      {
        "language": "gcode",
        "scopeName": "source.gcode",
        "path": "./syntaxes/gcode.tmLanguage.json"
      },
      {
        "language": "fanuc-tp",
        "scopeName": "source.gcode",
        "path": "./syntaxes/gcode.tmLanguage.json"
      },
      {
        "language": "abb-rapid",
        "scopeName": "source.gcode",
        "path": "./syntaxes/gcode.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "JobLine G-Code",
      "properties": {
        "jobline.ui.showLinks": {
          "type": "boolean",
          "default": true,
          "description": "Show optional JobLine for shops and G-Code Academy links in the sidebar and hover cards."
        },
        "jobline.controlType": {
          "type": "string",
          "default": "fanuc",
          "enum": [
            "fanuc",
            "haas",
            "siemens",
            "mazak",
            "okuma",
            "mitsubishi",
            "heidenhain",
            "fadal",
            "generic",
            "fanuc-robot",
            "abb"
          ],
          "enumDescriptions": [
            "Fanuc 0i / 30i / 31i CNC series",
            "Haas NGC controls",
            "Siemens Sinumerik 840D / 828D",
            "Mazak Smooth / Matrix controls (EIA/ISO)",
            "Okuma OSP-P controls",
            "Mitsubishi M8 / M80 (Meldas)",
            "Heidenhain TNC — Klartext and ISO",
            "Fadal Format 2",
            "Generic ISO / LinuxCNC",
            "Fanuc Robot — TP / LS teach-pendant programs",
            "ABB Robot — RAPID .mod programs"
          ],
          "description": "CNC or robot control dialect. Each CNC control has its own validation rules (codes, macro syntax, loops and jumps, limits)."
        },
        "jobline.controlAutoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Check each program as the control its header names (a Haas post writes \"HAAS MILL NGC\"; Okuma, Mazak, Siemens, Fadal, Mitsubishi and Heidenhain are recognised too). A control set for this workspace or folder (Select CNC / Robot Control Type, or a machine preset) always wins."
        },
        "jobline.machineType": {
          "type": "string",
          "default": "mill",
          "enum": [
            "mill",
            "lathe",
            "mill-turn",
            "grinder",
            "laser"
          ],
          "enumDescriptions": [
            "Mill profile: drilling/spotface cycles like G81/G82/G83 plus rigid tapping.",
            "Lathe profile: turning-oriented cycles such as G74/G76 and drilling cycles.",
            "Mill-turn profile: combined mill + lathe cycle families.",
            "Grinder profile: simplified drilling/position cycles (commonly G81/G82).",
            "Laser profile: 2D/tube CNC laser cutting (beam on/off, pierce, no spindle or tool length)."
          ],
          "description": "Machine type profile used to tailor cycle lists and axis assumptions in JobLine views."
        },
        "jobline.units": {
          "type": "string",
          "default": "inch",
          "enum": [
            "inch",
            "metric"
          ],
          "description": "Default unit system (can be overridden by G20/G21 in program)."
        },
        "jobline.validation.enableSafetyChecks": {
          "type": "boolean",
          "default": true,
          "description": "Enable crash-prevention safety rules (safe Z before tool change, spindle stop, etc.)."
        },
        "jobline.validation.enableArcValidation": {
          "type": "boolean",
          "default": true,
          "description": "Validate G02/G03 arc endpoint geometry and plane correctness."
        },
        "jobline.validation.arcTolerance": {
          "type": "number",
          "default": 0.001,
          "description": "Arc endpoint tolerance in current units (default 0.001 inch)."
        },
        "jobline.validation.controlSpecificRules": {
          "type": "boolean",
          "default": true,
          "description": "Run the rule set for the selected control (Fanuc, Haas, Siemens, Okuma, Mazak, Mitsubishi, Heidenhain, Fadal, generic) in addition to the shared ISO checks."
        },
        "jobline.formatter.wordSpacing": {
          "type": "boolean",
          "default": true,
          "description": "Add spaces between G-code words (G01X1.5 → G01 X1.5)."
        },
        "jobline.formatter.decimalPlaces": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Fixed decimal places for coordinates (null = don't change)."
        },
        "jobline.formatter.uppercaseGM": {
          "type": "boolean",
          "default": true,
          "description": "Uppercase G and M codes."
        },
        "jobline.detectedMachineType": {
          "type": "string",
          "default": "",
          "description": "Detailed machine type in use (e.g. \"Turn Center (2-Axis)\"). Set by machine presets and JobLine: Select Machine Type."
        },
        "jobline.additionalExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra file extensions to treat as G-code (e.g. [\".cpp\", \".sub\", \".001\"]). Useful for shop-specific file naming conventions not covered by the built-in list."
        },
        "jobline.machinePreset": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Id of the active machine preset (`.jblmachine`). Set it in **User** settings to make it the default for every workspace; a workspace value overrides it. Use **JobLine: Switch Machine** rather than editing by hand — applying a preset also sets control type, machine type and units."
        },
        "jobline.presets.libraryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Folder for your own machine presets. Empty uses `~/.jobline/machines`, the same default jobline.ai-CAM uses, so presets saved in either app appear in both."
        },
        "jobline.presets.sharedFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Extra folders of `.jblmachine` files to offer, e.g. a shop network share that jobline.ai-CAM also points at."
        },
        "jobline.presets.warnOnMismatch": {
          "type": "boolean",
          "default": true,
          "description": "Offer to switch machine when a program uses features the active machine preset does not have (turning codes on a mill, rotary axes on a 3-axis, a robot program on a CNC)."
        },
        "jobline.revpack.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "When a G-code program opens in the visualizer, load revpack.json from the same folder (or a parent revpack/ folder) and take stock, workholding, work offsets, tools and machine from it. Correlation findings appear in the Problems panel."
        },
        "jobline.cam.watchFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Folders your CAM posts NC programs into. JobLine offers to open new programs and link their setup sheets. File-based only: no connection to the CAM application."
        },
        "jobline.cam.autoLinkSetupSheets": {
          "type": "boolean",
          "default": true,
          "description": "When a program opens, link a setup sheet (HTML, XML or CSV) with the same name in the same folder, so its tool list feeds the tool checks."
        }
      }
    },
