          "group": "navigation@4"
        },
        {
          "command": "jobline.presets.openLibrary",
          "when": "view == jobline.machineSetupTree",
          "group": "1_library"
        },
        {
          "command": "jobline.presets.saveCurrent",
          "when": "view == jobline.machineSetupTree",
          "group": "1_library"
        },
        {
