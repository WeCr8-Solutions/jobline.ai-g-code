        },
        {
          "command": "jobline.sidebar.nextCycle",
          "when": "view == jobline.cannedCyclesTree",
          "group": "navigation@2"
        },
        {
          "command": "jobline.sidebar.prevProbe",
          "when": "view == jobline.probingTree",
          "group": "navigation@1"
        },
        {
          "command": "jobline.sidebar.nextProbe",
          "when": "view == jobline.probingTree",
          "group": "navigation@2"
        },
        {
          "command": "jobline.sidebar.prevMacro",
          "when": "view == jobline.macrosTree",
          "group": "navigation@1"
        },
        {
