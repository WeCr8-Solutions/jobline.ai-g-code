# Per-computer settings for the agent loop. Copy to .agent-loop/host.env in
# each clone (it is gitignored) and edit. KEY=VALUE, one per line.

# Name shown in `monitor` and on claims. Use the computer's name.
JOBLINE_AGENT_HOST=yumsourcandy
# What this computer can do; its OS is added automatically.
# Tasks with runsOn: [...] only go to computers with all those tags.
JOBLINE_AGENT_TAGS=gpu,lmstudio
# Share the queue and publish heartbeats through the git remote.
JOBLINE_AGENT_QUEUE=git
# 1 on exactly ONE computer: it also runs the CI gate and files fix tasks.
JOBLINE_AGENT_GATE=0

# Local model servers this computer may use (comma-separated).
LMSTUDIO_HOSTS=http://localhost:1234
LMSTUDIO_MODEL=qwen2.5-coder-14b-instruct
OLLAMA_HOSTS=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Claude, if this computer should escalate to it (leave empty to stay local).
# JOBLINE_AGENT_CLAUDE_MODEL=
# ANTHROPIC_API_KEY=

# CAM view checks: a Chromium build matching Playwright, if not installed by npx playwright install.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Exit and update (git pull) every so often, so fixes merged during the night are picked up.
JOBLINE_AGENT_RESTART_EVERY=3h
# Stop taking new tasks at this local time (empty = run until stopped).
# JOBLINE_AGENT_UNTIL=06:30
