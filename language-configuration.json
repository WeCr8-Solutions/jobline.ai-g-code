{
  "comments": {
    "lineComment": ";",
    "blockComment": ["(", ")"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*\\(\\s*(OP|OPERATION|TOOL|BEGIN).*\\)\\s*$",
      "end": "^\\s*\\(\\s*(END|ENDOP).*\\)\\s*$"
    }
  },
  "wordPattern": "[A-Z#$][-+]?[0-9]*\\.?[0-9]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(IF|WHILE|DO)\\b",
    "decreaseIndentPattern": "^\\s*(END|ENDIF)\\b"
  }
}
