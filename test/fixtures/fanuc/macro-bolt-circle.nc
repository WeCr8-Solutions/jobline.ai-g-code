%
O09100 (BOLT CIRCLE DRILL - MACRO B)
(USES VARIABLES FOR PARAMETRIC PROGRAMMING)
N10 G17 G20 G40 G49 G80 G90
N20 #1 = 2.0         (BOLT CIRCLE RADIUS)
N30 #2 = 6           (NUMBER OF HOLES)
N40 #3 = -0.75       (Z DEPTH)
N50 #4 = 0.1         (R PLANE)
N60 #5 = 0.125       (PECK DEPTH)
N70 #6 = 10.0        (FEED RATE)
N80 #7 = 3500        (SPINDLE SPEED)
N90 #10 = 0.0        (CENTER X)
N100 #11 = 0.0       (CENTER Y)
N110 #20 = 0         (ANGLE COUNTER)
N120 #21 = 360 / #2  (ANGLE INCREMENT)
N130 T01 M06 (0.25 DRILL)
N140 G43 H01 Z1.0
N150 M03 S#7
N160 M08
N170 G54
N180 WHILE [#20 LT #2] DO 1
N190   #30 = #10 + #1 * COS[#20 * #21]
N200   #31 = #11 + #1 * SIN[#20 * #21]
N210   IF [#20 EQ 0] GOTO 300
N220   G83 X#30 Y#31 Z#3 R#4 Q#5 F#6
N230   GOTO 400
N300   G83 X#30 Y#31 Z#3 R#4 Q#5 F#6
N400   #20 = #20 + 1
N410 END 1
N420 G80
N430 M09
N440 G91 G28 Z0
N450 M05
N460 M30
%
