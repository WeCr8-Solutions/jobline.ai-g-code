{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "G-Code",
  "scopeName": "source.gcode",
  "fileTypes": ["nc", "gcode", "ngc", "tap", "cnc", "mpf", "spf", "prg", "min"],
  "patterns": [
    { "include": "#comment-semicolon" },
    { "include": "#comment-parentheses" },
    { "include": "#block-skip" },
    { "include": "#percent-delimiter" },
    { "include": "#program-number" },
    { "include": "#line-number" },
    { "include": "#macro-control-flow" },
    { "include": "#macro-assignment" },
    { "include": "#siemens-cycle-call" },
    { "include": "#okuma-call" },
    { "include": "#g-code-motion" },
    { "include": "#g-code-cycle" },
    { "include": "#g-code-coordinate" },
    { "include": "#g-code-other" },
    { "include": "#m-code-spindle-coolant" },
    { "include": "#m-code-program" },
    { "include": "#m-code-other" },
    { "include": "#macro-expression" },
    { "include": "#macro-variable" },
    { "include": "#tool-call" },
    { "include": "#address-axis" },
    { "include": "#address-feed-speed" },
    { "include": "#address-offset" },
    { "include": "#address-parameter" },
    { "include": "#numeric-value" }
  ],
  "repository": {
    "comment-semicolon": {
      "match": ";.*$",
      "name": "comment.line.semicolon.gcode"
    },
    "comment-parentheses": {
      "begin": "\\(",
      "end": "\\)",
      "name": "comment.block.parentheses.gcode",
      "patterns": [
        {
          "match": "(?i)(OP\\s*\\d+|TOOL|DRILL|TAP|BORE|FACE|ROUGH|FINISH|CHAMFER|SLOT|POCKET|CONTOUR|THREAD|GROOVE|PART-OFF)",
          "name": "keyword.other.operation-label.gcode"
        }
      ]
    },
    "block-skip": {
      "match": "^\\s*/",
      "name": "keyword.operator.block-skip.gcode"
    },
    "percent-delimiter": {
      "match": "^\\s*%\\s*$",
      "name": "keyword.control.delimiter.gcode"
    },
    "program-number": {
      "patterns": [
        {
          "match": "(?i)^\\s*[Oo]\\d{1,8}",
          "name": "entity.name.function.program-number.gcode"
        },
        {
          "match": "^\\s*\\$\\d{1,8}",
          "name": "entity.name.function.program-number.okuma.gcode"
        }
      ]
    },
    "line-number": {
      "match": "(?i)\\bN\\d+\\b",
      "name": "comment.line.line-number.gcode"
    },
    "macro-control-flow": {
      "patterns": [
        {
          "match": "(?i)\\b(IF|THEN|ELSE|ENDIF|GOTO|WHILE|DO|END|EQ|NE|GT|GE|LT|LE|AND|OR|NOT)\\b",
          "name": "keyword.control.macro.gcode"
        }
      ]
    },
    "macro-assignment": {
      "match": "(?i)(#\\d+|#\\[.+?\\]|R\\d+)\\s*=",
      "captures": {
        "1": { "name": "variable.other.macro.gcode" }
      }
    },
    "siemens-cycle-call": {
      "match": "(?i)\\b(CYCLE[0-9]{2,3}|MCALL|HOLES[12]|POCKET[1-4]|SLOT[12]|LONGHOLE|SWIVEL)\\b",
      "name": "entity.name.function.cycle.siemens.gcode"
    },
    "okuma-call": {
      "match": "(?i)\\b(CALL)\\s+(OB\\d+|OSP\\d+)",
      "captures": {
        "1": { "name": "keyword.control.call.okuma.gcode" },
        "2": { "name": "entity.name.function.subprogram.okuma.gcode" }
      }
    },
    "g-code-motion": {
      "match": "(?i)\\b[Gg]\\s*(0?0|0?1|0?2|0?3|28|30|53)\\b",
      "name": "keyword.control.motion.gcode"
    },
    "g-code-cycle": {
      "match": "(?i)\\b[Gg]\\s*(7[0-6]|8[0-9])\\b",
      "name": "keyword.control.canned-cycle.gcode"
    },
    "g-code-coordinate": {
      "match": "(?i)\\b[Gg]\\s*(1[7-9]|20|21|40|41|42|43|43\\.4|49|5[4-9]|54\\.1|90|90\\.1|91|91\\.1)\\b",
      "name": "keyword.control.coordinate.gcode"
    },
    "g-code-other": {
      "match": "(?i)\\b[Gg]\\s*\\d{1,3}(\\.\\d)?\\b",
      "name": "keyword.other.g-code.gcode"
    },
    "m-code-spindle-coolant": {
      "match": "(?i)\\b[Mm]\\s*(0?3|0?4|0?5|0?7|0?8|0?9|19)\\b",
      "name": "keyword.control.spindle-coolant.gcode"
    },
    "m-code-program": {
      "match": "(?i)\\b[Mm]\\s*(0?0|0?1|0?2|0?6|30|98|99)\\b",
      "name": "keyword.control.program-flow.gcode"
    },
    "m-code-other": {
      "match": "(?i)\\b[Mm]\\s*\\d{1,3}\\b",
      "name": "keyword.other.m-code.gcode"
    },
    "macro-expression": {
      "begin": "\\[",
      "end": "\\]",
      "name": "meta.expression.macro.gcode",
      "patterns": [
        { "include": "#macro-variable" },
        { "include": "#macro-function" },
        { "include": "#macro-operator" },
        { "include": "#numeric-value" },
        { "include": "#macro-expression" }
      ]
    },
    "macro-variable": {
      "patterns": [
        {
          "match": "#\\d+",
          "name": "variable.other.macro.gcode"
        },
        {
          "match": "(?i)#V\\d+",
          "name": "variable.other.macro.okuma.gcode"
        },
        {
          "match": "(?i)\\bR\\d{1,3}\\b(?=\\s*[=\\+\\-\\*/,\\)])",
          "name": "variable.other.r-parameter.siemens.gcode"
        }
      ]
    },
    "macro-function": {
      "match": "(?i)\\b(SIN|COS|TAN|ATAN|ASIN|ACOS|SQRT|ABS|ROUND|FIX|FUP|LN|EXP|BIN|BCD)\\b",
      "name": "support.function.macro.gcode"
    },
    "macro-operator": {
      "match": "(?i)\\b(MOD|AND|OR|XOR|NOT)\\b",
      "name": "keyword.operator.macro.gcode"
    },
    "tool-call": {
      "match": "(?i)\\b[Tt]\\s*\\d{1,4}\\b",
      "name": "entity.name.tag.tool.gcode"
    },
    "address-axis": {
      "match": "(?i)\\b[XYZABC]\\s*[-+]?",
      "name": "variable.parameter.axis.gcode"
    },
    "address-feed-speed": {
      "match": "(?i)\\b[FS]\\s*",
      "name": "variable.parameter.feed-speed.gcode"
    },
    "address-offset": {
      "match": "(?i)\\b[HD]\\s*\\d+",
      "name": "variable.parameter.offset.gcode"
    },
    "address-parameter": {
      "match": "(?i)\\b[IJKRQPLU]\\s*[-+]?",
      "name": "variable.parameter.gcode"
    },
    "numeric-value": {
      "match": "[-+]?\\d*\\.?\\d+",
      "name": "constant.numeric.gcode"
    }
  }
}
